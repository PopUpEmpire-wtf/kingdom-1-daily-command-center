// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum DataSource {
  NOTION
  TASKADE
  FILESYSTEM
  IOS_REMINDERS
  IOS_NOTES
  TASKFLOW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model Project {
  id          String     @id @default(uuid())
  source      DataSource
  externalId  String     // ID from Notion or Taskade
  title       String
  description String?
  status      TaskStatus @default(TODO)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  lastSyncAt  DateTime   @default(now())

  tasks       Task[]

  @@unique([source, externalId])
  @@index([source])
  @@index([status])
}

model Task {
  id          String     @id @default(uuid())
  source      DataSource
  externalId  String     // ID from Notion or Taskade
  title       String
  description String?
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  tags        String?    // JSON string array
  assignees   String?    // JSON string array
  priority    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  lastSyncAt  DateTime   @default(now())

  projectId   String?
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([source])
  @@index([status])
  @@index([projectId])
}

model CalendarEvent {
  id          String     @id @default(uuid())
  source      DataSource
  externalId  String     // ID from Notion or Taskade
  title       String
  description String?
  startDate   DateTime
  endDate     DateTime?
  allDay      Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  lastSyncAt  DateTime   @default(now())

  @@unique([source, externalId])
  @@index([source])
  @@index([startDate])
}

model CanvasNode {
  id          String   @id @default(uuid())
  type        String   // 'integration', 'project', 'document'
  label       String
  positionX   Float
  positionY   Float
  icon        String?
  status      String?
  metadata    String?  // JSON string for additional data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sourceEdges CanvasEdge[] @relation("SourceNode")
  targetEdges CanvasEdge[] @relation("TargetNode")
}

model CanvasEdge {
  id          String   @id @default(uuid())
  type        String   // 'sync', 'reference', 'dependency'
  label       String?
  sourceId    String
  targetId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  source      CanvasNode @relation("SourceNode", fields: [sourceId], references: [id], onDelete: Cascade)
  target      CanvasNode @relation("TargetNode", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([targetId])
}

model SyncLog {
  id          String     @id @default(uuid())
  source      DataSource
  status      String     // 'SUCCESS', 'ERROR', 'PARTIAL'
  message     String?
  itemsSynced Int        @default(0)
  timestamp   DateTime   @default(now())
  createdAt   DateTime   @default(now())

  @@index([source])
  @@index([createdAt])
  @@index([timestamp])
}

model TaskMapping {
  id              String     @id @default(uuid())
  canonicalId     String     // Main task ID (UUID)
  source          DataSource
  sourceId        String     // External ID from source
  sourcePath      String?    // File path or URL
  confidence      Float      @default(1.0) // Merge confidence (0-1)
  lastVerified    DateTime   @default(now())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([source, sourceId])
  @@index([canonicalId])
  @@index([source])
}

model FileSystemTask {
  id          String   @id @default(uuid())
  filePath    String
  lineNumber  Int?
  taskType    String   // 'TODO', 'FIXME', 'HACK', 'NOTE', 'MARKDOWN'
  content     String
  context     String?  // Surrounding code/text
  status      TaskStatus @default(TODO)
  priority    String?
  tags        String?
  metadata    String?  // JSON for additional data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastScanAt  DateTime @default(now())

  @@unique([filePath, lineNumber, content])
  @@index([filePath])
  @@index([taskType])
  @@index([status])
}
