# Database Configuration
# SQLite database file location
DATABASE_URL="file:./dev.db"

# Notion Integration
# Get your API key from: https://www.notion.so/my-integrations
NOTION_API_KEY="secret_xxxxxxxxxxxxx"

# Notion Database IDs (found in database URLs)
# Format: https://notion.so/workspace/<DATABASE_ID>?v=...
NOTION_DATABASE_ID_PROJECTS="xxxxxxxxxxxxx"
NOTION_DATABASE_ID_TASKS="xxxxxxxxxxxxx"
NOTION_DATABASE_ID_DOCS="xxxxxxxxxxxxx"

# Taskade Integration
# Get your token from: Taskade Settings → Developer → Personal Access Tokens
TASKADE_API_TOKEN="xxxxxxxxxxxxx"

# Find in your workspace URL: https://taskade.com/app/<WORKSPACE_ID>
TASKADE_WORKSPACE_ID="xxxxxxxxxxxxx"

# Generate a random secret for webhook verification (e.g., openssl rand -hex 32)
TASKADE_WEBHOOK_SECRET="xxxxxxxxxxxxx"

# Application Configuration
# Public URL for the application (update for production deployment)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
